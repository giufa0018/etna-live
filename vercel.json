{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": { "api/firms.mjs": { "memory": 256, "maxDuration": 15 } },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=180, s-maxage=300" }]
    }
  ]
}
